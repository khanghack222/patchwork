{
  "name": "patchwork-cli",
  "version": "0.1.0",
  "description": "AI-powered dependency changelog scanner. Detect breaking changes before they break you.",
  "type": "module",
  "bin": {
    "patchwork": "./dist/index.js"
  },
  "main": "./packages/core/index.ts",
  "exports": {
    ".": "./packages/core/index.ts",
    "./types": "./packages/core/types.ts"
  },
  "files": [
    "dist",
    "packages",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run packages/cli/index.ts",
    "build": "bun build packages/cli/index.ts --outdir dist --target bun --minify",
    "scan": "bun run packages/cli/index.ts scan",
    "serve": "bun run packages/cli/index.ts serve",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/khanghack222/patchwork.git"
  },
  "homepage": "https://github.com/khanghack222/patchwork",
  "bugs": "https://github.com/khanghack222/patchwork/issues",
  "keywords": [
    "dependency",
    "changelog",
    "breaking-changes",
    "upgrade",
    "ai",
    "llm",
    "npm",
    "pip",
    "cargo",
    "golang",
    "devtools",
    "cli",
    "semver",
    "risk-score",
    "dashboard"
  ],
  "author": "khanghack222",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "hono": "^4.7.0",
    "open": "^10.1.0",
    "ora": "^8.1.0",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/semver": "^7.5.8"
  }
}
